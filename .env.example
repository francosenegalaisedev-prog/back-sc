# Copie ce fichier en .env puis adapte les valeurs.
NODE_ENV=development
PORT=4000
SERVER="http://localhost:4000/api"

# PostgreSQL (voir docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fiche_db?schema=public"

# Génère une vraie clé : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-change-me-change-me-change-me"
JWT_EXPIRES_IN=7d

# Origines autorisées (séparées par des virgules) : l'URL du frontend
CORS_ORIGIN="http://localhost:5173"

# Base publique du site (liens dans les e-mails, QR codes, NFC)
PUBLIC_SITE_URL="http://localhost:5173"

# true = un client doit confirmer son e-mail avant certaines actions
REQUIRE_EMAIL_VERIFICATION=false

# Nombre max de fiches gratuites par compte (valeur par défaut)
MAX_FICHES_PER_USER=3

# E-mails (SMTP : Mailtrap en dev, Brevo / Resend / SMTP en prod)
MAILTRAP_SMTP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_SMTP_PORT="2525"
MAILTRAP_SMTP_USER="your-smtp-user"
MAILTRAP_SMTP_PASSWORD="your-smtp-password"
MAIL_FROM_ADDRESS="no-reply@logcard.com"
MAIL_FROM_NAME="LogCard"
# URL publique HTTPS du logo affiché dans les e-mails (optionnel)
LOGO_PATH=""

# Stockage S3 (SeaweedFS / S3 compatible)
S3_REGION="us-east-1"
S3_ENDPOINT="http://127.0.0.1:8333"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_BUCKET="ficheimage"

# Clé de chiffrement 2FA AES-256 (64 caractères hex = 32 octets)
# Générer avec : npm run generate-tfa-key
TWO_FA_ENCRYPTION_KEY="ChangeeE"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Compte administrateur initial (script create-admin)
ADMIN_EMAIL="admin@logcard.io"
ADMIN_PASSWORD="ChangeMeAdmin123!"
ADMIN_NAME="Administrateur"
